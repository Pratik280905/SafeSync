# Local canvas / engine.exe
ROCKETRIDE_URI=ws://localhost:5565
ROCKETRIDE_APIKEY=

# Cloud (after login at https://cloud.rocketride.ai — paste token, not localhost)
# ROCKETRIDE_URI=https://api.rocketride.ai
# ROCKETRIDE_APIKEY=
# ROCKETRIDE_AUTH=

ROCKETRIDE_GROQ_KEY=
GROQ_API_KEY=

GROQ_ANALYST_MODEL=openai/gpt-oss-120b
GROQ_VERIFIER_MODEL=openai/gpt-oss-20b

SAFESYNC_DB=./safesync.db
SAFESYNC_USE_LLM=1
SAFESYNC_HOST=127.0.0.1
SAFESYNC_PORT=8000
